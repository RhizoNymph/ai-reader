<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only sherpa-onnx is checksum-verified: it is fetched from GitHub releases rather than
  a Maven repository. Everything else is trusted. When bumping sherpaOnnx in
  libs.versions.toml, update the component below to match.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]k2fsa$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.k2fsa" name="sherpa-onnx" version="1.13.2">
         <artifact name="sherpa-onnx-1.13.2.aar">
            <sha256 value="aa5505c0ec4f8bdaee5f214a64ba3012be64f2aecc022e82a64f33392b8dd245" origin="k2-fsa/sherpa-onnx GitHub release v1.13.2"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
